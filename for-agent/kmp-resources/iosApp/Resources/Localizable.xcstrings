          "stringUnit": {
            "state": "translated",
            "value": "What happens to photos"
          }
        }
      }
    },
    "privacy_photo_body": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মাপ বের হলেই ছবি মুছে যায়। কোথাও সেভ বা পাঠানো হয় না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos are deleted as soon as measuring is done. Never saved or sent."
          }
        }
      }
    },
    "privacy_net_title": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইন্টারনেট লাগে না"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No internet needed"
          }
        }
      }
    },
    "privacy_net_body": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপ ইন্টারনেট ব্যবহার করে না। শেয়ার করলে শুধু আপনার বেছে নেওয়া অ্যাপে যায়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app does not use the internet. Shared files go only to the app you choose."
          }
        }
      }
    },
    "privacy_delete_title": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কীভাবে মুছবেন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How to delete"
          }
        }
      }
    },
    "privacy_delete_body": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেটিংস › \"সব ডেটা মুছুন\" চাপুন। অ্যাপ আনইনস্টল করলেও সব মুছে যায়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to Settings › \"Delete all data\". Uninstalling the app also deletes everything."
          }
        }
      }
    },
