    "onb1_step1": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিজের উচ্চতা লিখুন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your height"
          }
        }
      }
    },
    "onb1_step2": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সামনে ও পাশ থেকে দুটি ছবি তুলুন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take two photos, front and side"
          }
        }
      }
    },
    "onb1_step3": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপ নিজেই মাপ বের করে দেবে"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app works out your measurements"
          }
        }
      }
    },
    "onb1_note": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফিতা থাকলে নিজে মেপেও লিখতে পারবেন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Have a tape? You can measure and type it in yourself."
          }
        }
      }
    },
    "onb2_title": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার তথ্য আপনার ফোনেই"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data stays on your phone"
          }
        }
      }
    },
    "onb2_point1": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইন্টারনেট ছাড়াই পুরো অ্যাপ চলে"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Works fully without internet"
          }
        }
      }
    },
    "onb2_point2": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছবি ও মাপ কোথাও আপলোড হয় না"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos and measurements are never uploaded"
          }
        }
      }
    },
    "onb2_point3": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যখন খুশি সব মুছে ফেলতে পারেন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete everything whenever you want"
          }
        }
      }
    },
    "onb3_title": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
