    "onb3_point1": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF বা ছবি হিসেবে হোয়াটসঅ্যাপ, মেসেঞ্জারে পাঠান"
